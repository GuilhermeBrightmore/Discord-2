{
  "name": "@discord2/desktop",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "electron:compile": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --external:electron-updater --outdir=dist-electron --out-extension:.js=.cjs --sourcemap",
    "dev": "npm run electron:compile && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build && npm run electron:compile",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "publish:update": "npm run build && electron-builder --win nsis --publish always",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@discord2/contracts": "*",
    "@livekit/components-react": "^2.9.14",
    "@livekit/components-styles": "^1.1.6",
    "@supabase/supabase-js": "^2.57.2",
    "electron-updater": "6.8.9",
    "livekit-client": "^2.15.5",
    "lucide-react": "^0.542.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "43.4.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.guilherme.discord2",
    "productName": "FungoCord",
    "executableName": "FungoCord",
    "asar": true,
    "protocols": [{ "name": "FungoCord Invite", "schemes": ["fungocord"] }],
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.ico", "artifactName": "FungoCord-Setup-${version}-${arch}.${ext}" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true },
    "portable": { "artifactName": "FungoCord-Portable-${version}-${arch}.${ext}" },
    "publish": [{ "provider": "github", "owner": "GuilhermeBrightmore", "repo": "Discord-2", "releaseType": "release" }]
  }
}
