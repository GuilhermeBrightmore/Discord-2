# Supabase Cloud. No modo local, iniciar-local.bat gera estes valores automaticamente.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
SUPABASE_SERVICE_ROLE_KEY=sb_secret_SUBSTITUA

# LiveKit Cloud em producao; servidor SFU local no modo LAN.
LIVEKIT_URL=wss://SEU-PROJETO.livekit.cloud
LIVEKIT_API_KEY=SUBSTITUA
LIVEKIT_API_SECRET=SUBSTITUA
PUBLIC_LIVEKIT_URL=wss://SEU-PROJETO.livekit.cloud

# Variaveis incorporadas no renderer pelo Vite.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
VITE_API_URL=http://127.0.0.1:8787
VITE_LIVEKIT_URL=wss://SEU-PROJETO.livekit.cloud

# Opcional na Vercel: link direto usado pelos botoes de download da landing page.
NEXT_PUBLIC_DOWNLOAD_URL=https://github.com/GuilhermeBrightmore/Discord-2/releases/latest

PORT=8787
ALLOWED_ORIGINS=app://discord2,http://localhost:5173
