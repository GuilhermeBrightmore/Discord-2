{
  "name": "fungocord-central",
  "version": "1.3.0",
  "private": true,
  "description": "Cliente Electron e backend centralizado do FungoCord",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:server": "npm run dev -w @discord2/local-server",
    "dev:desktop": "npm run dev -w @discord2/desktop",
    "dev": "concurrently -n SERVER,DESKTOP -c cyan,magenta \"npm run dev:server\" \"npm run dev:desktop\"",
    "build": "npm run build --workspaces --if-present",
    "build:desktop": "npm run dist:win -w @discord2/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > packages/contracts/src/database.generated.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "esbuild": "0.28.2",
    "supabase": "^2.39.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
